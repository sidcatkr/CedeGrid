  "scenario_contracts": [
    {
      "id": "PUB-01",
      "scenario": "Final native descriptor UTF-8 size boundary",
      "cases": [
        1048575,
        1048576,
        1048577
      ],
      "accepted": [
        true,
        true,
        false
      ],
      "include_unicode": true,
      "old_head_unchanged_on_rejection": true
    },
    {
      "id": "PUB-02",
      "scenario": "Concurrent quota reservations, previous generations, interrupted files",
      "assertions": [
        "Atomic node-wide reservation",
        "No overspend",
        "Predecessor remains charged until safe GC",
        "Uncertain orphan charge retained"
      ]
    },
    {
      "id": "PUB-03",
      "scenario": "Precommit validation/write failure",
      "assertions": [
        "Previous head/bytes/hash unchanged",
        "Unused charge released only after verified cleanup"
      ]
    },
    {
      "id": "PUB-04",
      "scenario": "Directory-sync or DB commit uncertainty",
      "error": "ERR_CEDEGRID_PUBLICATION_UNCERTAIN",
      "assertions": [
        "Original publication ID retained",
        "Previous valid generation recoverable",
        "Candidate retained",
        "Retry never creates another generation"
      ]
    },
    {
      "id": "PUB-05",
      "scenario": "Local/coordinator acknowledgement loss and restart",
      "assertions": [
        "Query/retry original identity",
        "Existing committed outcome returned",
        "No duplicate acceptance",
        "No new execution"
      ]
    },
    {
      "id": "IO-01",
      "scenario": "FIFO/device/intermediate symlink descriptor",
      "assertions": [
        "Open does not wait for FIFO writer",
        "Rejected before regular-file read",
        "No path escape"
      ]
    },
    {
      "id": "IO-02",
      "scenario": "Growing descriptor",
      "assertions": [
        "Read count <=1048577 bytes",
        "Hash/parse same bytes",
        "Oversize rejected"
      ]
    },
    {
      "id": "IO-03",
      "scenario": "Publication/polling/reclamation bounded read coverage",
      "assertions": [
        "No unbounded fallback reader",
        "Only NotFound permits plain result"
      ]
    },
    {
      "id": "IO-04",
      "scenario": "Concurrent descriptor replacement or pinned blob GC",
      "assertions": [
        "New generation not deleted based on old read",
        "Pinned inode survives verification and commit"
      ]
    },
    {
      "id": "IO-05",
      "scenario": "Download nested-directory sync and replacement uncertainty",
      "assertions": [
        "Created directories and parent entries synchronized",
        "Pre-replace failure preserves destination",
        "Post-replace sync uncertainty is explicit",
        "No false strong Windows directory-durability claim"
      ]
    },
    {
      "id": "REC-01",
      "scenario": "Pause old supervisor with DB connections/output/capture thread",
      "assertions": [
        "No rename before all guards close",
        "No resource charge release",
        "No new execution"
      ]
    },
    {
      "id": "REC-02",
      "scenario": "Two recovery contenders and arriving reader",
      "assertions": [
        "One maintenance owner",
        "Admission blocks new readers",
        "No lock conversion assumption",
        "Nested old access completes"
      ]
    },
    {
      "id": "REC-03",
      "scenario": "Delayed old supervisor and stale Python/TS/C publication request",
      "assertions": [
        "Old identity rejected after guard acquisition",
        "No new namespace data access"
      ]
    },
    {
      "id": "REC-04",
      "scenario": "Duplicate/CLOEXEC descriptors and capture lifetime",
      "assertions": [
        "No early unlock",
        "No authoritative descriptor inherited by worker",
        "Guard retained until final native handle closes"
      ]
    },
    {
      "id": "REC-05",
      "scenario": "Lost fencing acknowledgement or coordinator connection",
      "assertions": [
        "No cached snapshot treated as fresh authority",
        "Reservations retained",
        "Placement remains disabled"
      ]
    },
    {
      "id": "REC-06",
      "scenario": "Crash at each persisted recovery phase",
      "assertions": [
        "Quarantines retained",
        "Partial state non-runnable",
        "Fresh authenticated session on process restart",
        "No automatic rerun"
      ]
    },
    {
      "id": "SDK-01",
      "scenario": "String/bytes argv, bad cwd/env, bool/overflow resources",
      "assertions": [
        "Validation before environment/transport access",
        "Remote cwd not checked on submission host"
      ]
    },
    {
      "id": "SDK-02",
      "scenario": "Malformed or lost spawn success reply",
      "assertions": [
        "SpawnUncertain retains generated request ID",
        "No helper subprocess proxy"
      ]
    },
    {
      "id": "SDK-03",
      "scenario": "Mixed ESM/CJS runtime and declaration consumers",
      "assertions": [
        "Same constructors",
        "Stable error.code",
        "Typechecks both entrypoints"
      ]
    },
    {
      "id": "TLS-01",
      "scenario": "CA/hostname/role/identity/redirect/proxy negatives",
      "assertions": [
        "Unauthorized peers rejected",
        "No credential redirect",
        "Environment proxies unused"
      ]
    },
    {
      "id": "PAGE-01",
      "scenario": "Page count/full-envelope byte bounds",
      "limits": {
        "default_items": 100,
        "max_items": 1000,
        "max_response_bytes": 7340032,
        "client_read_bound_bytes": 8388608
      }
    },
    {
      "id": "PAGE-02",
      "scenario": "Single oversized item",
      "error": "ERR_CEDEGRID_ITEM_TOO_LARGE",
      "assertions": [
        "Small explicit error",
        "No unchanged-cursor loop"
      ]
    },
    {
      "id": "PAGE-03",
      "scenario": "Continuous insertion with high-water cursor",
      "assertions": [
        "Traversal terminates at original high-water",
        "No silent snapshot promise"
      ]
    },
    {
      "id": "PAGE-04",
      "scenario": "Filter tampering or coordinator restart",
      "assertions": [
        "Mismatched cursor rejected",
        "Cursor-expired explicit",
        "SDK never silently restarts"
      ]
    },
    {
      "id": "PAGE-05",
      "scenario": "Shared pool/node job filtering",
      "assertions": [
        "Only scoped reservations/reports counted",
        "Global node telemetry labeled",
        "Unknown inventory rejects job filter"
      ]
    },
    {
      "id": "PAGE-06",
      "scenario": "NodeReport limit",
      "limits": {
        "max_items": 2048,
        "max_bytes": 2097152
      },
      "assertions": [
        "No truncation",
        "Reservations retained on overflow",
        "No new placement"
      ]
    },
    {
      "id": "PAGE-07",
      "scenario": "Indexed first-page scaling",
      "limits": {
        "datasets_tasks": [
          100000,
          1000000
        ],
        "measurements_per_dataset": 30,
        "sqlite_cache_mib": 16,
        "max_incremental_rss_mib": 64,
        "p95_ms_strictly_less_than": 1000
      }
    },
    {
      "id": "DOCTOR-01",
      "scenario": "Strict durability unavailable but selected replay profile admitted",
      "assertions": [
        "Both statuses reported separately",
        "Readiness follows selected profile",
        "Coordinator still requires strict storage"
      ]
    },
    {
      "id": "UPGRADE-01",
      "scenario": "Offline legacy format/byte-preserving migration",
      "assertions": [
        "WAL2/DELETE3 migrate to schema5",
        "Replay4 requires authenticated recovery",
        "Original hashes/IDs preserved",
        "Upgrade holds prevent retries",
        "Future versions refused before original mutation"
      ]
    },
    {
      "id": "UPGRADE-02",
      "scenario": "Legacy outbox/backup/interrupted upgrade/downgrade",
      "assertions": [
        "Full private bundle includes sidecars and outboxes",
        "Unresolved/corrupt records retained",
        "No old supervisor spec execution",
        "No in-place downgrade"
      ]
    }
  ]
}

