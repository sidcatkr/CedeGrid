  "conventions": {
    "purpose": "Normative shared test inputs and outcomes, not evidence that implementations passed.",
    "paths": "Fixture paths are POSIX-relative to a harness-created root unless absolute syntax is under test; the harness performs path substitution, never the runtime config loader.",
    "expected_numbers": "Expected exact integers are decimal strings with explicit kind; input JSON is raw text to avoid fixture-loader precision loss.",
    "config_stage": "Parse, normalize and validate config semantics; certificate authenticity/loading is exercised separately by TLS-01.",
    "runtime_data_format": "RPC/job/pool/replay/result inputs remain JSON; runtime config files are TOML."
  },
