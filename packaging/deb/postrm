#!/bin/sh
# cedegrid-system: on purge, leave the host as it was before the install (005 FR-034).
set -e
case "$1" in
    remove)
        systemctl daemon-reload || true
        # The socket's directory; empty once the socket is gone.
        rmdir /run/cedegrid 2>/dev/null || true
        ;;
    purge)
        systemctl daemon-reload || true
        rmdir /run/cedegrid 2>/dev/null || true
        if getent group cedegrid >/dev/null; then
            groupdel cedegrid || true
        fi
        # Kept only if an administrator added files there.
        rmdir /etc/cedegrid 2>/dev/null || true
        ;;
esac
