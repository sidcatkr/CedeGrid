# The System mode broker: starts and stops members' units, moves their jobs between them and
# writes OOM scores inside them (005 FR-002 to FR-011). Started only by its socket.
[Unit]
Description=CedeGrid System mode broker
Requires=cedegrid-broker.socket
After=cedegrid-broker.socket

[Service]
Type=simple
ExecStart=/usr/bin/cedegrid __system-broker
# A raise ends with the broker that set it, however the broker stopped (006 FR-018).
ExecStopPost=/usr/bin/cedegrid __system-broker end-raises
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
# CAP_SYS_RESOURCE: write oom_score_adj below a process's own floor (and set that floor).
# CAP_DAC_OVERRIDE: write oom_score_adj and the cgroup files of users' processes and units,
# which belong to those users. Nothing else: no ptrace, no setuid, no other capability.
CapabilityBoundingSet=CAP_SYS_RESOURCE CAP_DAC_OVERRIDE
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
